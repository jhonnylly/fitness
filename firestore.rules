rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Para leer /users/{uid}: resource.data ya ES el documento evaluado,
    // no hace falta get() (y con get() las consultas de lista fallan).
    function isMyClientDoc() {
      return isSignedIn() && resource.data.trainerId == request.auth.uid && activo();
    }
    // Para las rutinas: aquí resource.data es la rutina, no el usuario padre,
    // así que sí hace falta get() al documento del cliente dueño.
    function isTrainerOfParent(uid) {
      return isSignedIn() && activo() &&
        get(/databases/$(database)/documents/users/$(uid)).data.trainerId == request.auth.uid;
    }

    // Una invitación abierta creada por un entrenador. El código es aleatorio
    // y va en la URL que el entrenador comparte con su cliente.
    function invitacionValida(inviteId, trainerId) {
      return inviteId is string
        && exists(/databases/$(database)/documents/invites/$(inviteId))
        && get(/databases/$(database)/documents/invites/$(inviteId)).data.trainerId == trainerId
        && get(/databases/$(database)/documents/invites/$(inviteId)).data.usado == false;
    }

    /* ═══════════ Códigos de alta de ENTRENADOR ═══════════
       Hasta ahora las cuentas de entrenador se creaban a mano en la consola de
       Firebase, y estas reglas dejaban a cualquiera crearse un perfil con
       role:'trainer' (el comentario de más abajo lo admitía: "un desconocido
       podría crearse un perfil de entrenador suelto"). Eso valía mientras el
       candado real fuera tener la creación de cuentas desactivada en
       Authentication. En cuanto se abre para que los entrenadores se den de
       alta solos, ese agujero pasa a ser la puerta de casa: sin esto,
       cualquiera tendría gratis lo que se va a cobrar.

       Un código de alta lo genera SOLO Jhon (admin), sirve una vez y es lo
       único que permite crear un perfil de entrenador. */
    function soyAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    /* ═══ Suspensión por impago ═══
       Un entrenador suspendido pierde TODO lo que hace de entrenador: ver a sus
       clientes, tocarles el plan, invitar, proponer retos y mandarles avisos.

       🔴 Va aquí y NO en la interfaz. Esconder botones no suspende a nadie:
       quien no paga seguiría teniendo acceso completo con solo no usar mis
       pantallas. Esto es lo que hace que el cobro sea real.

       Lo que NO se toca: sus clientes siguen entrenando y viendo sus propios
       datos con normalidad. El cliente no ha dejado de pagar nada, y castigarle
       por la deuda de su entrenador sería tanto perderle a él como al coach.
       Y el propio entrenador conserva su entrenamiento personal: lo que se
       suspende es el servicio que se cobra, no su cuenta.

       `!= true` y no `== false`: las cuentas de antes de esto no tienen el
       campo, y sin ese matiz quedarían todas suspendidas de golpe. */
    function activo() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspendido != true;
    }

    function altaValida(altaId) {
      return altaId is string
        && exists(/databases/$(database)/documents/altas/$(altaId))
        && get(/databases/$(database)/documents/altas/$(altaId)).data.usado == false;
    }

    match /altas/{codigo} {
      // get sí, list no: el candidato necesita leer el suyo para el alta, pero
      // enumerarlos daría la lista de códigos sin gastar de todo el mundo.
      allow get: if isSignedIn();
      allow list: if soyAdmin();
      allow create, delete: if soyAdmin();
      // Solo se puede tocar para gastarlo, y solo quien lo gasta. No se puede
      // reabrir un código ya usado.
      allow update: if isSignedIn()
                    && resource.data.usado == false
                    && request.resource.data.usado == true
                    && request.resource.data.usadoPor == request.auth.uid;
    }

    match /invites/{codigo} {
      // get sí, list no para quien no es el dueño: los códigos son aleatorios,
      // pero poder enumerarlos daría la lista de invitaciones abiertas de
      // todos los entrenadores. El invitado necesita get para leer quién le
      // invita; el entrenador necesita list para ver las suyas pendientes.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.trainerId == request.auth.uid;
      // Suspendido no reparte invitaciones: sería seguir creciendo sin pagar.
      allow create: if isSignedIn() && activo()
                    && request.resource.data.trainerId == request.auth.uid
                    && request.resource.data.usado == false;
      // Solo se puede tocar para marcarla usada, y solo quien la usa. No se
      // permite reabrirla ni cambiarle el entrenador.
      allow update: if isSignedIn()
                    && resource.data.usado == false
                    && request.resource.data.usado == true
                    && request.resource.data.usadoPor == request.auth.uid
                    && request.resource.data.trainerId == resource.data.trainerId;
      // Revocar una invitación pendiente: solo quien la creó.
      allow delete: if isSignedIn() && resource.data.trainerId == request.auth.uid;
    }

    // ═══════════ Retos del entrenador ═══════════
    // Un reto lo crea un entrenador y lo ven él y SUS clientes. El marcador de
    // cada participante vive en una subcolección propia: así el ranking se
    // comparte SIN abrir los datos de entrenamiento de nadie. Un cliente sigue
    // sin poder leer las rutinas, las medidas ni las fotos de otro; lo único
    // que se publica es el número del reto, y solo si acepta participar.
    function miEntrenador() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trainerId;
    }
    function coachDelReto(retoId) {
      return get(/databases/$(database)/documents/retos/$(retoId)).data.trainerId;
    }

    match /retos/{retoId} {
      // El cliente los pide con where('trainerId','==', su entrenador), así que
      // cada documento que llega cumple la condición. Pedirlos todos falla.
      allow read: if isSignedIn()
                  && (resource.data.trainerId == request.auth.uid
                      || resource.data.trainerId == miEntrenador());
      allow create: if isSignedIn() && activo()
                    && request.resource.data.trainerId == request.auth.uid;
      /* Cerrar o borrar un reto es cosa de quien lo puso. Esto NO exige estar
         activo a propósito: un entrenador suspendido tiene que poder cerrar un
         reto que dejó abierto, y cerrarlo no le da nada. */
      allow update, delete: if isSignedIn() && resource.data.trainerId == request.auth.uid;

      match /participantes/{uid} {
        allow read: if isSignedIn()
                    && (coachDelReto(retoId) == request.auth.uid
                        || coachDelReto(retoId) == miEntrenador());
        // Cada uno escribe SOLO su propia fila, y solo en retos de su
        // entrenador: nadie puede apuntarse al reto de otro gimnasio ni
        // tocarle el marcador a un compañero.
        allow write: if isOwner(uid) && coachDelReto(retoId) == miEntrenador();
      }
    }

    match /users/{uid} {
      // isTrainerProfile: cualquier usuario autenticado puede leer un perfil
      // si su rol es "trainer" (necesario para que el invitado vea quién le
      // invita). No permite listar todos los entrenadores, solo leer uno del
      // que ya se conoce el ID exacto.
      allow read: if isOwner(uid) || isMyClientDoc() || (isSignedIn() && resource.data.role == 'trainer');

      // Un cliente solo existe si trae una invitación válida de su entrenador.
      // Esto es lo que impide que un desconocido se cuelgue de la lista de
      // clientes de nadie.
      //
      // LÍMITE CONOCIDO: crear la cuenta *vacía* en Auth no se puede impedir
      // sin blocking functions (Cloud Functions -> plan Blaze, de pago). Sin
      // perfil aquí, esa cuenta no tiene datos, ni entrenador, ni acceso a
      // nada de nadie.
      //
      // Un perfil de ENTRENADOR exige ahora un código de alta válido, igual
      // que uno de cliente exige invitación. Antes se permitía sin más porque
      // esas cuentas se creaban a mano en la consola; desde que los
      // entrenadores se dan de alta solos, es lo que separa a un cliente de
      // pago de cualquiera que pase por la web.
      // Nadie se crea a sí mismo con privilegios: `admin` se pone desde la
      // consola y `suspendido` solo lo escribe el admin.
      allow create: if isOwner(uid)
                    && !('admin' in request.resource.data)
                    && !('suspendido' in request.resource.data)
                    && (
                      (request.resource.data.role == 'trainer'
                       && altaValida(request.resource.data.altaId))
                      || (request.resource.data.role == 'client'
                          && invitacionValida(request.resource.data.inviteId,
                                              request.resource.data.trainerId))
                    );
      // El dueño puede cambiar lo suyo. Su entrenador NO: solo se le permiten
      // dos gestos concretos, y cada uno tocando un único campo.
      //   - activeRoutine: cambiarle al cliente la rutina en curso. Manda este
      //     campo, no el "active" de cada rutina: el backend del cliente
      //     reescribe esos flags a partir de aquí en cada guardado.
      //   - trainerId: solo para ponerlo a null (desvincular). Así un
      //     entrenador no puede endosarle el cliente a otro.
      //   - avisoCoach / sesionCoach: el recado que le pone en Inicio y el
      //     cambio de día. Son DOS campos y no uno a propósito: "Entendido"
      //     (que escribe el cliente) solo toca avisoCoach, así que cerrar el
      //     mensaje no puede llevarse por delante la sesión impuesta. Se le
      //     exige firmar ambos con su propio uid en `de`, así que no puede
      //     dejar nada que parezca de otro entrenador. Ponerlos a null es
      //     retirarlos, y eso sí se permite sin firma. El cliente los borra
      //     por su cuenta con isOwner, que ya está más arriba.
      /* 🔴 `suspendido` y `admin` NO los puede tocar el dueño, y esto no es un
         detalle: sin esta línea, un entrenador suspendido se quita la
         suspensión editando su propio documento —la suspensión no valdría
         nada— y CUALQUIERA puede ponerse admin:true y regalarse códigos de
         alta. isOwner() da permiso sobre todo el documento, así que los dos
         campos que otorgan privilegios hay que sacarlos a mano.
         Los pone el admin (abajo) o la consola de Firebase, nadie más. */
      allow update: if (isOwner(uid)
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['suspendido','admin']))
                    /* Suspender o reactivar a un entrenador por impago. Solo el
                       admin, y solo ese campo: no puede tocarle nada más de su
                       perfil. Es lo que sostiene el cobro. */
                    || (soyAdmin()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['suspendido']))
                    || (isMyClientDoc()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['activeRoutine']))
                    || (isMyClientDoc()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['trainerId'])
                        && request.resource.data.trainerId == null)
                    || (isMyClientDoc()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['avisoCoach','sesionCoach'])
                        && (request.resource.data.avisoCoach == null
                            || request.resource.data.avisoCoach.de == request.auth.uid)
                        && (request.resource.data.sesionCoach == null
                            || request.resource.data.sesionCoach.de == request.auth.uid));
      allow delete: if false;

      match /routines/{routineId} {
        allow read: if isOwner(uid) || isTrainerOfParent(uid);
        allow write: if isOwner(uid) || isTrainerOfParent(uid);
      }

      // Fotos de progreso: son de la PERSONA, no de una rutina, y por eso
      // tienen colección propia. Un documento por foto porque cada una ronda
      // los 215 KB y el límite duro de Firestore es 1 MiB por documento: en
      // un único documento cabrían cuatro.
      //
      // El entrenador LEE (las ve en la ficha de su cliente) pero NO escribe:
      // las fotos del cuerpo de alguien las pone y las quita esa persona.
      // Es más restrictivo que /routines, donde sí puede escribir para
      // corregirle el plan, y es a propósito.
      match /fotos/{fotoId} {
        allow read: if isOwner(uid) || isTrainerOfParent(uid);
        allow write: if isOwner(uid);
      }
    }
  }
}
